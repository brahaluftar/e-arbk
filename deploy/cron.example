# Replace /var/www/e-arbk with the release path and confirm the PHP binary using `command -v php`.
# Process every queued Excel import at least once per minute, without overlap.
* * * * * cd /cloudclusters/arbk/current && /usr/bin/flock -n /cloudclusters/arbk/shared/imports.lock /usr/bin/php bin/process-imports.php >> /cloudclusters/arbk/shared/log/imports.log 2>&1
# Remaining synchronization tasks.
*/15 * * * * cd /cloudclusters/arbk/current && /usr/bin/php bin/run-scheduled.php >> /cloudclusters/arbk/shared/log/scheduled.log 2>&1
* * * * * cd /cloudclusters/arbk/current && /usr/bin/flock -n /cloudclusters/arbk/shared/annual-invoices.lock /usr/bin/php bin/process-annual-invoices.php 200 >> /cloudclusters/arbk/shared/log/annual-invoices.log 2>&1

# SQL Server backup mode only. Managed CloudClusters backups are configured in the control panel instead.
15 2 * * * cd /var/www/e-arbk && /usr/bin/php bin/backup-database.php >> var/log/backup.log 2>&1

# Daily health evidence.
30 6 * * * /usr/bin/curl --fail --silent --show-error https://arbk.example.org/health.php > /dev/null

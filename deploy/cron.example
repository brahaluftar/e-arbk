# ARBK scheduled jobs. deploy/install-cron.sh writes the same entries to /etc/cron.d/e-arbk.
# Paths assume the CloudClusters layout (/cloudclusters/arbk/current); confirm the PHP binary with `command -v php`.

# Excel imports, every minute, never overlapping.
* * * * * cd /cloudclusters/arbk/current && /usr/bin/flock -n /cloudclusters/arbk/shared/imports.lock /usr/bin/php bin/process-imports.php >> /cloudclusters/arbk/shared/log/imports.log 2>&1
# Annual invoice jobs and their PDF/Excel exports, every minute, never overlapping.
* * * * * cd /cloudclusters/arbk/current && /usr/bin/flock -n /cloudclusters/arbk/shared/annual-invoices.lock /usr/bin/php bin/process-annual-invoices.php 200 >> /cloudclusters/arbk/shared/log/annual-invoices.log 2>&1
# ATK status, tariff relation and automatic NACE classification, every 15 minutes.
*/15 * * * * cd /cloudclusters/arbk/current && /usr/bin/flock -n /cloudclusters/arbk/shared/scheduled.lock /usr/bin/php bin/run-scheduled.php >> /cloudclusters/arbk/shared/log/scheduled.log 2>&1

# Optional: only with BACKUP_MODE=sqlserver. Managed CloudClusters backups are configured in the control panel instead.
# 15 2 * * * cd /cloudclusters/arbk/current && /usr/bin/php bin/backup-database.php >> /cloudclusters/arbk/shared/log/backup.log 2>&1

# Optional: daily health evidence.
# 30 6 * * * /usr/bin/curl --fail --silent --show-error https://arbk.kryeqyteti.net/health.php > /dev/null

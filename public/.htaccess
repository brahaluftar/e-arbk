Options -Indexes
DirectoryIndex index.php
RewriteEngine On

RewriteRule ^$ index.php [L]
RewriteRule ^admin/dashboard/?$ admin/dashboard.php [L,QSA]
RewriteRule ^admin/businesses/classification/?$ admin/businesses/index.php?classification=UNCLASSIFIED [L,QSA]
RewriteRule ^admin/businesses/([0-9]+)/?$ admin/businesses/view.php?id=$1 [L,QSA]
RewriteRule ^admin/businesses/?$ admin/businesses/index.php [L,QSA]

<FilesMatch "^\.ht">
    Require all denied
</FilesMatch>

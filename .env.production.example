APP_ENV=production
APP_DEBUG=false
APP_URL=https://arbk.kryeqyteti.net
APP_TIMEZONE=Europe/Warsaw
APP_SESSION_NAME=arbk_admin
APP_KEY=REPLACE_WITH_AT_LEAST_32_RANDOM_CHARACTERS
FORCE_HTTPS=true
TRUST_PROXY_HEADERS=true

DB_HOST=sql-server-host,1433
DB_NAME=ARBK
DB_USER=arbk_application
DB_PASSWORD=REPLACE_WITH_DATABASE_PASSWORD
DB_TRUSTED_CONNECTION=false
DB_ENCRYPT=true
DB_TRUST_SERVER_CERTIFICATE=false

PAGE_SIZE=25
CSRF_TTL_SECONDS=7200
LOGIN_RATE_WINDOW_SECONDS=900
LOGIN_RATE_MAX_ATTEMPTS=5
LOGIN_RATE_BLOCK_SECONDS=900

# managed = backups configured in CloudClusters; sqlserver = BACKUP DATABASE job below
BACKUP_MODE=managed
DB_BACKUP_PATH=
IMPORT_MAX_BYTES=157286400

APP_ENV=production
APP_DEBUG=false
APP_URL=https://arbk.kryeqyteti.net
APP_TIMEZONE=Europe/Warsaw
APP_SESSION_NAME=arbk_admin
APP_KEY=REPLACE_WITH_AT_LEAST_32_RANDOM_CHARACTERS
GRAPH_TENANT_ID=REPLACE_WITH_MICROSOFT_ENTRA_TENANT_ID
GRAPH_CLIENT_ID=REPLACE_WITH_MICROSOFT_ENTRA_APPLICATION_CLIENT_ID
GRAPH_CLIENT_SECRET=REPLACE_WITH_MICROSOFT_ENTRA_CLIENT_SECRET
GRAPH_SENDER_MAILBOX=no-reply@kryeqyteti.net
GRAPH_BASE_URL=https://graph.microsoft.com/v1.0
GRAPH_TIMEOUT_SECONDS=15
PASSWORD_RESET_TTL_SECONDS=1800
FORCE_HTTPS=true
TRUST_PROXY_HEADERS=true

DB_HOST=sql-server-host,1433
DB_NAME=ARBK
DB_USER=arbk_application
DB_PASSWORD=REPLACE_WITH_DATABASE_PASSWORD
DB_TRUSTED_CONNECTION=false
DB_ENCRYPT=true
DB_TRUST_SERVER_CERTIFICATE=false

PAGE_SIZE=25
CSRF_TTL_SECONDS=7200
LOGIN_RATE_WINDOW_SECONDS=900
LOGIN_RATE_MAX_ATTEMPTS=5
LOGIN_RATE_BLOCK_SECONDS=900

# managed = backups configured in CloudClusters; sqlserver = BACKUP DATABASE job below
BACKUP_MODE=managed
DB_BACKUP_PATH=
IMPORT_MAX_BYTES=157286400
INVOICE_DUE_DAYS=30
MUNICIPALITY_NAME=KOMUNA E PRISHTINËS
MUNICIPALITY_ADDRESS=REPLACE_WITH_MUNICIPAL_ADDRESS
MUNICIPALITY_CONTACT=REPLACE_WITH_MUNICIPAL_CONTACT
MUNICIPAL_BANK_ACCOUNT=REPLACE_WITH_MUNICIPAL_IBAN
INVOICE_LEGAL_TEXT="Kjo faturë është lëshuar nga sistemi komunal për tarifën vjetore të ushtrimit të veprimtarisë. Pagesa realizohet duke përdorur UNIREF-in e paraqitur në faturë."
